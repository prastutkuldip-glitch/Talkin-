# ---------------------------------------------------------------------------
# TalkinShield — example environment configuration
#
# Copy to `.env` and fill in. NEVER commit a populated `.env`.
# In deployed environments these values are supplied by CDK (plain config) and
# AWS Secrets Manager (anything sensitive). Nothing secret belongs in this file.
# ---------------------------------------------------------------------------

# --- Core / runtime -------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
# Deployment stage: dev | staging | prod
STAGE=dev

# --- AWS ------------------------------------------------------------------
AWS_REGION=us-east-1
# Account id is only needed for local CDK synth/deploy.
CDK_DEFAULT_ACCOUNT=
CDK_DEFAULT_REGION=us-east-1

# --- Amazon Cognito (authentication) -------------------------------------
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
# Comma-separated list of groups allowed to perform moderation actions.
MODERATOR_GROUPS=moderators,admins
ADMIN_GROUPS=admins

# --- DynamoDB tables ------------------------------------------------------
TABLE_EVENTS=talkinshield-events
TABLE_USER_STATE=talkinshield-user-state
TABLE_INCIDENTS=talkinshield-incidents
TABLE_SIGNALS=talkinshield-signals
TABLE_ACTIONS=talkinshield-actions
TABLE_RULES=talkinshield-rules
TABLE_AUDIT=talkinshield-audit
TABLE_RATELIMIT=talkinshield-ratelimit

# --- S3 evidence storage --------------------------------------------------
EVIDENCE_BUCKET=
# Object Lock retention in days for WORM evidence protection.
EVIDENCE_OBJECT_LOCK_DAYS=30

# --- KMS ------------------------------------------------------------------
KMS_KEY_ID=
KMS_EVIDENCE_KEY_ALIAS=alias/talkinshield-evidence

# --- EventBridge ----------------------------------------------------------
EVENT_BUS_NAME=talkinshield-bus
EVENT_SOURCE=talkinshield.detection

# --- Amazon Bedrock (text/behaviour classification) ----------------------
# Leave BEDROCK_ENABLED=false to run on deterministic rules only.
BEDROCK_ENABLED=false
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
BEDROCK_MAX_TOKENS=512
BEDROCK_TIMEOUT_MS=4000
# Classifier prompt/rubric version — recorded on every stored decision.
BEDROCK_CLASSIFIER_VERSION=1.0.0

# --- Amazon Transcribe (voice) -------------------------------------------
# Only ever enable where you hold a lawful basis and participant consent for
# processing call audio. See docs/AUTHORIZATION_BOUNDARY.md.
TRANSCRIBE_ENABLED=false
TRANSCRIBE_LANGUAGE_CODE=en-US
TRANSCRIBE_OUTPUT_BUCKET=
TRANSCRIBE_VOCABULARY_NAME=

# --- Talkin platform integration -----------------------------------------
# adapter: noop | mock | http
# `noop`  - no platform integration; capabilities report as UNAVAILABLE.
# `mock`  - local mock adapter for development and tests.
# `http`  - real official Talkin moderation API (requires credentials below).
TALKIN_ADAPTER=mock
TALKIN_API_BASE_URL=
# Secrets Manager secret name holding the Talkin API credentials.
# The raw token is NEVER read from an env var in deployed stages.
TALKIN_API_SECRET_NAME=talkinshield/talkin-api
TALKIN_API_TIMEOUT_MS=5000

# Declares which capabilities your Talkin authorization actually grants.
# Setting one of these to `true` without real authorization is a policy
# violation, not a feature. The system degrades safely when they are false.
TALKIN_CAP_MESSAGE_CONTENT=true
TALKIN_CAP_MODERATION_EVENTS=true
TALKIN_CAP_VOICE_AUDIO=false
TALKIN_CAP_HIDDEN_PRESENCE=false
TALKIN_CAP_CLIENT_ATTESTATION=false
TALKIN_CAP_REMOTE_MUTE=false
TALKIN_CAP_REMOTE_BLOCK=false

# --- Rate limiting / ingestion -------------------------------------------
INGEST_RATE_LIMIT_PER_MINUTE=600
INGEST_MAX_BATCH_SIZE=50
INGEST_MAX_MESSAGE_LENGTH=4000
API_RATE_LIMIT_PER_MINUTE=120

# --- Data retention (days) -----------------------------------------------
RETENTION_RAW_EVENTS_DAYS=30
RETENTION_SIGNALS_DAYS=90
RETENTION_INCIDENTS_DAYS=365
RETENTION_EVIDENCE_DAYS=365
RETENTION_AUDIT_DAYS=730

# --- Alerting -------------------------------------------------------------
ALERT_SNS_TOPIC_ARN=
# Optional outbound webhook; the URL itself is held in Secrets Manager.
ALERT_WEBHOOK_SECRET_NAME=
ALERT_MIN_LEVEL=HIGH

# --- Frontend (Vite) ------------------------------------------------------
VITE_API_BASE_URL=http://localhost:3000
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=
VITE_AWS_REGION=us-east-1
# Set to `true` to run the dashboard against local mock data with no backend.
VITE_USE_MOCK_API=true
